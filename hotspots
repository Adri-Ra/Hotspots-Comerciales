        "# ------------------------------------------------------------------------------\n",
        "# FASE A: RECOLECCIÓN, LIMPIEZA Y ANÁLISIS EXPLORATORIO\n",
        "# ------------------------------------------------------------------------------\n",
        "# Cargamos el archivo exportado de Overpass Turbo\n",
        "with open('export.geojson', 'r', encoding='utf-8') as f:\n",
        "    data = json.load(f)\n",
        "\n",
        "registros = []\n",
        "for feature in data['features']:\n",
        "    props = feature.get('properties', {})\n",
        "    geom = feature.get('geometry', {})\n",
        "    coords = geom.get('coordinates', [])\n",
        "\n",
        "    # Extraer coordenadas (GeoJSON usa [longitud, latitud] o centro si es polígono)\n",
        "    if geom.get('type') == 'Point' and len(coords) >= 2:\n",
        "        lon, lat = coords[0], coords[1]\n",
        "    elif 'center' in feature:\n",
        "        lon, lat = feature['center']['lon'], feature['center']['lat']\n",
        "    else:\n",
        "        continue\n",
        "\n",
        "    registros.append({\n",
        "        'name': props.get('name', 'Sin nombre registrado'),\n",
        "        'category': props.get('tourism', 'hotel'),\n",
        "        'latitude': float(lat),\n",
        "        'longitude': float(lon),\n",
        "        'city_municipality': props.get('addr:city', props.get('addr:municipality', 'La Paz (No especificado)'))\n",
        "    })\n",
        "\n",
        "df = pd.DataFrame(registros)\n",
        "\n",
        "# Documentación de limpieza: eliminar duplicados exactos y coordenadas nulas\n",
        "total_inicial = len(df)\n",
        "df = df.dropna(subset=['latitude', 'longitude'])\n",
        "df = df.drop_duplicates(subset=['name', 'latitude', 'longitude']).reset_index(drop=True)\n",
        "\n",
        "print(f\"--- FASE A: EXPLORACIÓN Y LIMPIEZA ---\")\n",
        "print(f\"Registros extraídos inicialmente de OSM: {total_inicial}\")\n",
        "print(f\"Registros limpios y únicos: {len(df)}\")\n",
        "print(df.head(10))\n",
        "print(\"\\nConteo por categoría:\")\n",
        "print(df['category'].value_counts())\n",
        "\n",
        "# Exportar dataset limpio a CSV\n",
        "df.to_csv('dataset_hoteles_la_paz_limpio.csv', index=False, encoding='utf-8')\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# FASE B: K-MEANS (AGRUPACIÓN GEOGRÁFICA)\n",
        "# ------------------------------------------------------------------------------\n",
        "X_coords = df[['latitude', 'longitude']].values\n",
        "\n",
        "# Probamos K=3\n",
        "k_elegido = 3\n",
        "kmeans = KMeans(n_clusters=k_elegido, random_state=42, n_init=10)\n",
        "df['cluster'] = kmeans.fit_predict(X_coords)\n",
        "centroides = kmeans.cluster_centers_\n",
        "\n",
        "print(f\"\\n--- FASE B: K-MEANS (K={k_elegido}) ---\")\n",
        "for i, c in enumerate(centroides):\n",
        "    print(f\"Cluster {i} -> Centroide en Lat: {c[0]:.5f}, Lon: {c[1]:.5f} | Total lugares: {(df['cluster']==i).sum()}\")\n",
        "\n",
        "# Gráfico de dispersión estático\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.scatterplot(data=df, x='longitude', y='latitude', hue='cluster', palette='Set1', s=80)\n",
        "plt.scatter(centroides[:, 1], centroides[:, 0], c='black', s=200, marker='X', label='Centroides')\n",
        "plt.title('Distribución de Hoteles en La Paz (K-Means)')\n",
        "plt.xlabel('Longitud')\n",
        "plt.ylabel('Latitud')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# FASE C: KNN (UBICACIÓN REAL EN TIERRA FIRME DE LAS HOJAS RESORT)\n",
        "# ------------------------------------------------------------------------------\n",
        "df['zona_etiqueta'] = np.where(df['latitude'] < 13.40, 'Zona Costera / Playa', 'Zona Interior / Urbana')\n",
        "\n",
        "X_rad = np.radians(df[['latitude', 'longitude']].values)\n",
        "y_zonas = df['zona_etiqueta'].values\n",
        "\n",
        "k_knn = 3\n",
        "knn = KNeighborsClassifier(n_neighbors=k_knn, metric='haversine')\n",
        "knn.fit(X_rad, y_zonas)\n",
        "\n",
        "# Coordenadas exactas en la franja de TIERRA FIRME (orilla de playa junto a los demás hoteles)\n",
        "nueva_lat = 13.3210\n",
        "nueva_lon = -88.9450\n",
        "nueva_ubicacion_rad = np.radians([[nueva_lat, nueva_lon]])\n",
        "\n",
        "clase_predicha = knn.predict(nueva_ubicacion_rad)[0]\n",
        "distancias_rad, indices_vecinos = knn.kneighbors(nueva_ubicacion_rad)\n",
        "distancias_km = distancias_rad[0] * 6371.0\n",
        "\n",
        "print(f\"\\n--- FASE C: RESULTADO DE KNN PARA LAS HOJAS RESORT (k={k_knn}) ---\")\n",
        "print(f\"Ubicación de Referencia (Tierra Firme): Lat {nueva_lat}, Lon {nueva_lon}\")\n",
        "print(f\"Clasificación asignada: {clase_predicha}\")\n",
        "print(\"Hoteles vecinos reales más cercanos extraídos de OpenStreetMap:\")\n",
        "vecinos_df = df.iloc[indices_vecinos[0]].copy()\n",
        "vecinos_df['distancia_km'] = distancias_km\n",
        "print(vecinos_df[['name', 'category', 'zona_etiqueta', 'distancia_km']])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# FASE D: MAPA INTERACTIVO CON FOLIUM (MAPA ESRI LIBRE DE BLOQUEOS 403)\n",
        "# ------------------------------------------------------------------------------\n",
        "mapa = folium.Map(\n",
        "    location=[nueva_lat, nueva_lon],\n",
        "    zoom_start=13,\n",
        "    tiles='Esri.WorldStreetMap'\n",
        ")\n",
        "\n",
        "colores_cluster = ['red', 'blue', 'green', 'purple', 'orange']\n",
        "\n",
        "# 1. Marcadores de los hoteles existentes en el departamento\n",
        "for _, row in df.iterrows():\n",
        "    color_punto = colores_cluster[row['cluster'] % len(colores_cluster)]\n",
        "    popup_texto = f\"<b>{row['name']}</b><br>Categoría: {row['category']}<br>Cluster: {row['cluster']}<br>Zona: {row['zona_etiqueta']}\"\n",
        "    folium.CircleMarker(\n",
        "        location=[row['latitude'], row['longitude']],\n",
        "        radius=6,\n",
        "        color=color_punto,\n",
        "        fill=True,\n",
        "        fill_color=color_punto,\n",
        "        fill_opacity=0.8,\n",
        "        popup=folium.Popup(popup_texto, max_width=250)\n",
        "    ).add_to(mapa)\n",
        "\n",
        "# 2. Marcadores de los Centroides de K-Means\n",
        "for i, c in enumerate(centroides):\n",
        "    folium.Marker(\n",
        "        location=[c[0], c[1]],\n",
        "        popup=f\"<b>Centroide Cluster {i}</b>\",\n",
        "        icon=folium.Icon(color='black', icon='star')\n",
        "    ).add_to(mapa)\n",
        "\n",
        "# 3. Marcador principal de Las Hojas Resort (Ubicación exacta en tierra firme)\n",
        "folium.Marker(\n",
        "    location=[nueva_lat, nueva_lon],\n",
        "    popup=f\"<b>LAS HOJAS RESORT (Referencia Principal)</b><br>Clasificación KNN: {clase_predicha}\",\n",
        "    icon=folium.Icon(color='orange', icon='star')\n",
        ").add_to(mapa)\n",
        "\n",
        "# 4. Líneas naranjas punteadas hacia los vecinos reales más cercanos\n",
        "for _, vecino in vecinos_df.iterrows():\n",
        "    folium.PolyLine(\n",
        "        locations=[[nueva_lat, nueva_lon], [vecino['latitude'], vecino['longitude']]],\n",
        "        color='orange',\n",
        "        weight=2.5,\n",
        "        dash_array='5, 5',\n",
        "        tooltip=f\"Vecino real: {vecino['name']} ({vecino['distancia_km']:.2f} km)\"\n",
        "    ).add_to(mapa)\n",
        "\n",
        "# Título y Leyenda HTML flotante en el mapa\n",
        "leyenda_html = '''\n",
        "<div style=\"position: fixed; bottom: 30px; left: 30px; width: 310px; z-index:9999;\n",
        "            background-color:white; border:2px solid grey; border-radius:8px; padding: 10px; font-size:13px;\">\n",
        "  <b>Hotspots Hoteleros - Las Hojas (Superalitos)</b><br>\n",
        "  • Puntos de color: Hoteles por Cluster K-Means<br>\n",
        "  ★ Marcador naranja: Las Hojas Resort (Ref.)<br>\n",
        "  --- Líneas naranjas: Hoteles vecinos reales (KNN)<br>\n",
        "  <small>Fuente: OpenStreetMap / Esri</small>\n",
        "</div>\n",
        "'''\n",
        "mapa.get_root().html.add_child(folium.Element(leyenda_html))\n",
        "\n",
        "# Guardar el mapa interactivo en HTML\n",
        "mapa.save('mapa_hotspots_la_paz.html')\n",
        "print(\"Mapa guardado con éxito como 'mapa_hotspots_la_paz.html'! Descárgalo desde el panel izquierdo.\")\n",
        "mapa"
      ]
    }
  ]
